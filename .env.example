# Optional path overrides. By default SmartFiles uses ./data.db and ./uploads.
# SMARTFILES_DB_PATH=
# SMARTFILES_UPLOAD_DIR=
# Optional online plagiarism reports from Quetext.
# Create an API key under Quetext Account > API Keys and keep it private.
QUETEXT_API_KEY=replace_with_your_quetext_api_key

# Optional online search fallback when Quetext is unconfigured or out of credits.
# Matches are only shown after checking overlap against Tavily-returned page text.
# TAVILY_API_KEY=

# Gemini API key is read only by the backend and is never sent to the browser.
GEMINI_API_KEY=your_gemini_api_key
# Ollama embedding model used to index and search document chunks.
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Optional inference timeout in seconds (5-300; default 120).
# OLLAMA_TIMEOUT_SECONDS=120
# OLLAMA_EMBED_TIMEOUT_SECONDS=90
