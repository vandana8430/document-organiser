# Optional path overrides. By default SmartFiles uses ./data.db and ./uploads.
# SMARTFILES_DB_PATH=
# SMARTFILES_UPLOAD_DIR=

# Optional online plagiarism reports from Quetext.
# Create an API key under Quetext Account > API Keys and keep it private.
QUETEXT_API_KEY=replace_with_your_quetext_api_key

# Optional Gemini conversational answers for the AI Assistant.
# Local extractive answers still work without this key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
